# Required for the private Telegram bot.
BOOKSAVER_TELEGRAM_BOT_TOKEN=

# Required by the default agentic inventory route. If omitted, configure
# agentic_browser.inventory_routing = "legacy" for scripted inventory.
BOOKSAVER_LLM_API_KEY=

# Required for encrypted personal keys and Booking.com sessions.
# Generate with Python's standard library:
# python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BOOKSAVER_SECRET_KEY=

# Required only with the Docker Compose remote-auth profile.
BOOKSAVER_AUTH_DOMAIN=connect.example.com

# Optional email notification credential.
# BOOKSAVER_SMTP_PASSWORD=
