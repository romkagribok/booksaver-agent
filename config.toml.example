[schedule]
# Every eligible booking participates in one random slot per broad UTC window.
checks_per_booking_per_day = 3
minimum_spacing = "2h"
missed_run_grace = "1h"

[storage]
# Docker Compose persists this directory in the booksaver-data volume.
data_directory = "/data"

[browser]
device_profile = "android-chromium"
locale = "en-US"
timezone_id = "UTC"

[extraction]
# Legacy extraction model settings normalize to the fixed primary profile below.

[agent]
# The adaptive portfolio is closed: Sonnet 5 handles normal ambiguous DOM work,
# Opus 5 receives at most one measured quality escalation, and Fable is rejected.
primary_model = "claude-sonnet-5"
escalation_model = "claude-opus-5"
max_job_cost_usd = "1.00"
max_deployment_daily_cost_usd = "10.00"
reserve_opus_diagnostic_for_ambiguous_episode = true
# Outer per-check limits. Recovery episodes stop sooner at the nested limits below.
max_steps = 15
max_llm_calls = 20
check_timeout_seconds = 180
# Backward-compatible defaults for one failed browser step (ADR-030).
max_recovery_calls_per_step = 4
recovery_timeout_seconds = 60
screenshot_after_no_progress = 2
max_semantic_action_executions = 2

[telegram_bot]
enabled = true
owner_chat_id = 123456789 # Replace with your numeric private-chat ID.
poll_timeout_seconds = 30

[remote_auth]
enabled = true
public_url = "https://connect.example.com" # Must match BOOKSAVER_AUTH_DOMAIN.
session_timeout_seconds = 600

[limits]
max_checks_per_user_per_day = 48
max_llm_calls_per_user_per_day = 200
messages_per_minute_per_chat = 20
