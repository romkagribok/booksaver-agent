# Copy to live-test.env and fill in your Anthropic key:
#   cp scripts/live-test.env.example scripts/live-test.env
#
# live-test.env is gitignored — never commit real secrets.

export BOOKSAVER_LLM_API_KEY="sk-ant-..."

# Optional overrides (defaults are fine for most tests):
# export BOOKSAVER_HOME="$HOME/.booksaver"
# export SKIP_AUTH=1          # skip interactive login if session already saved
# export SKIP_REGISTER=1      # skip registration if TEST-001 already exists
